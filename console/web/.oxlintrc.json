{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useLocale",
          "useSession",
          "useOperations",
          "useOperationRunner",
          "usePageCursor",
          "field",
          "nullableField",
          "buttonVariants",
          "badgeVariants",
          "healthLabel"
        ]
      }
    ],
    "react/incompatible-library": "off"
  }
}
