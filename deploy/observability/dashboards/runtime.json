{
  "id": null,
  "uid": "tidemq-runtime",
  "title": "TideMQ Runtime",
  "tags": [
    "tidemq",
    "runtime"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Role readiness",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tidemq_runtime_ready",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Local operation outcomes",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, operation, outcome) (rate(tidemq_operations_total[5m]))",
          "legendFormat": "{{instance}} {{operation}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Producer commit P99",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tidemq_stage_duration_seconds_bucket{operation=\"Produce\",stage=\"Commit\"}[5m])))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "WAL sync P99 by operation",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(tidemq_stage_duration_seconds_bucket{stage=\"Sync\"}[5m])))",
          "legendFormat": "{{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Read and durable ACK local P99",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(tidemq_stage_duration_seconds_bucket{operation=~\"Read|Ack\",stage=\"Total\"}[5m])))",
          "legendFormat": "{{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Independent capacity observations",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tidemq_capacity_used_bytes",
          "legendFormat": "{{instance}} {{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Capacity gates",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tidemq_capacity_blocked",
          "legendFormat": "{{instance}} {{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "tidemq_capacity_container_blocked",
          "legendFormat": "{{instance}} cgroup",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RSS and cgroup usage (do not add)",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tidemq_runtime_process_rss_bytes",
          "legendFormat": "{{instance}} RSS",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "tidemq_runtime_cgroup_current_bytes",
          "legendFormat": "{{instance}} cgroup",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "C",
          "expr": "tidemq_runtime_cgroup_limit_bytes",
          "legendFormat": "{{instance}} cgroup limit",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active QUIC connections",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tidemq_internal_client_active_connections",
          "legendFormat": "{{instance}} internal client",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "tidemq_internal_server_active_connections",
          "legendFormat": "{{instance}} internal server",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "C",
          "expr": "tidemq_external_server_active_connections",
          "legendFormat": "{{instance}} external",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "QUIC blocked frames and liveness failures",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemq_internal_client_stream_data_blocked_frames_total[5m])",
          "legendFormat": "{{instance}} stream blocked",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "rate(tidemq_internal_client_data_blocked_frames_total[5m])",
          "legendFormat": "{{instance}} connection blocked",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "C",
          "expr": "rate(tidemq_internal_client_liveness_failures_total[5m])",
          "legendFormat": "{{instance}} liveness failure",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "S3 HTTP attempts and retries",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemq_s3_sdk_attempts_total[5m])",
          "legendFormat": "{{instance}} attempts",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "rate(tidemq_s3_sdk_retries_total[5m])",
          "legendFormat": "{{instance}} retries",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Distinct lifecycle upload and publication",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemq_lifecycle_uploaded_total[5m])",
          "legendFormat": "{{instance}} uploaded",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "rate(tidemq_lifecycle_published_total[5m])",
          "legendFormat": "{{instance}} published",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Log evidence loss",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemq_runtime_log_dropped_events_total[5m])",
          "legendFormat": "{{instance}} queue dropped",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "rate(tidemq_runtime_log_sink_errors_total[5m])",
          "legendFormat": "{{instance}} sink errors",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "C",
          "expr": "rate(tidemq_runtime_log_oversized_events_total[5m])",
          "legendFormat": "{{instance}} oversized",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Collector health and scrape time",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"(tidemq-lab/)?tidemq\"}",
          "legendFormat": "{{instance}} up",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "scrape_duration_seconds{job=~\"(tidemq-lab/)?tidemq\"}",
          "legendFormat": "{{instance}} seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Verified local reclamation",
      "description": "Local monotonic metrics; a missing sample is unavailable. Example thresholds require a measured deployment baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemq_lifecycle_reclaimed_bytes_total[5m])",
          "legendFormat": "{{instance}} reclaimed bytes/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    }
  ],
  "links": [
    {
      "type": "link",
      "title": "Runtime runbook",
