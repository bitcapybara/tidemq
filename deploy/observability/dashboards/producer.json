{
  "id": null,
  "uid": "tidemq-producer",
  "title": "TideMQ Producer",
  "tags": [
    "tidemq",
    "producer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Attempt rate",
      "description": "Example dashboard; verify metric registration and tune thresholds against the production baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemq_producer_committed_attempts_total[5m])",
          "legendFormat": "new durable result",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "rate(tidemq_producer_duplicate_attempts_total[5m])",
          "legendFormat": "original result",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "C",
          "expr": "rate(tidemq_producer_rejected_attempts_total[5m])",
          "legendFormat": "rejected",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "D",
          "expr": "rate(tidemq_producer_unknown_attempts_total[5m])",
          "legendFormat": "unknown",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "New committed messages",
      "description": "Example dashboard; verify metric registration and tune thresholds against the production baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemq_producer_new_messages_total[5m])",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "New committed logical bytes",
      "description": "Example dashboard; verify metric registration and tune thresholds against the production baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemq_producer_new_bytes_total[5m])",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Owned pending operations",
      "description": "Example dashboard; verify metric registration and tune thresholds against the production baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tidemq_producer_pending_operations",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Owned pending bytes",
      "description": "Example dashboard; verify metric registration and tune thresholds against the production baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tidemq_producer_pending_bytes",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Broker commit wait P99",
      "description": "Example dashboard; verify metric registration and tune thresholds against the production baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tidemq_stage_duration_seconds_bucket{operation=\"Produce\",stage=\"Commit\"}[5m])))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ]
    }
  ],
  "links": [
    {
      "type": "link",
      "title": "Producer runbook",
      "url": "https://github.com/bitcapybara/tidemq/blob/main/docs/operations/producer-troubleshooting.zh-CN.md",
      "targetBlank": true
    }
  ]
}
